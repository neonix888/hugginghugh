# HuggingHugh Environment Variables
# Copy this to .env and fill in your values

# HuggingFace API Token (optional, for higher rate limits)
HF_TOKEN=

# Twitter API Credentials (for @HuggingHugh bot)
# Get these from https://developer.twitter.com/
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/hugginghugh

# Individual database settings (alternative to DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hugginghugh
DB_USER=
DB_PASSWORD=

# Newsletter Admin API Key (required for /stats and /subscribers endpoints)
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
NEWSLETTER_ADMIN_API_KEY=
